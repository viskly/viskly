<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime exceptions for Viskly.app, applied by build-app.sh.

  The set jpackage uses for its own signing, minus two it adds that this application does
  not need: debugger (attaching to other processes) and allow-dyld-environment-variables.

  allow-jit, allow-unsigned-executable-memory: the JVM compiles to native code at runtime.
  disable-library-validation: whisper-jni and sqlite-jdbc copy their libraries out of the
    jar into a temporary directory and load them from there.
  device.audio-input: under the hardened runtime the microphone is refused without it, and
    macOS does not even ask the user.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
